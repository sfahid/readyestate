{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003
    },
    {
      "name": "Run PHP development server",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "C:/wamp64/bin/php/php8.3.6/php.exe",
      "runtimeArgs": [
        "-dxdebug.mode=debug",
        "-dxdebug.start_with_request=yes",
        "-S",
        "127.0.0.1:8088",
        "-t",
        "public"
      ],
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Development Server \\(http://([^:]+:[0-9]+)\\) started",
        "uriFormat": "http://%s"
      }
    }
  ]
}
